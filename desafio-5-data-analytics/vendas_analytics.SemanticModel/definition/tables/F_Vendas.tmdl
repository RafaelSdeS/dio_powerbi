table F_Vendas
	lineageTag: 82869420-9c52-4e85-9a2b-c4af1b77abaf

	measure 'Total Vendas' = SUM(F_Vendas[Sales])
		formatString: $#,0
		displayFolder: Medidas
		lineageTag: cf9cb35c-f884-4b75-8fb9-027c8549344a

	measure 'Total Lucro' = SUM(F_Vendas[Profit])
		formatString: $#,0
		displayFolder: Medidas
		lineageTag: 485dbc3c-a9e2-400d-8296-31463b89f040

	measure 'Unidades Vendidas' = SUM(F_Vendas[Units Sold])
		formatString: #,0
		displayFolder: Medidas
		lineageTag: 7ebcb3cf-867d-4834-9ce9-6cde68f332e1

	measure 'Total Descontos' = SUM(F_Vendas[Discounts])
		formatString: $#,0
		displayFolder: Medidas
		lineageTag: afe95e14-c3d8-44e0-984b-c597b30a2b74

	measure 'Margem %' = DIVIDE([Total Lucro], [Total Vendas])
		formatString: 0.0%
		displayFolder: Medidas
		lineageTag: 987f875a-1f6f-45cf-bfed-99266852b7e9

	measure 'Ticket Medio' = DIVIDE([Total Vendas], [Unidades Vendidas])
		formatString: $#,0.00
		displayFolder: Medidas
		lineageTag: f0a3cf4b-ed5c-43d2-a331-aa5266d7481a

	measure 'Vendas Ano Anterior' = CALCULATE([Total Vendas], SAMEPERIODLASTYEAR(D_Calendario[Date]))
		formatString: $#,0
		displayFolder: Medidas
		lineageTag: 41a7e2f2-1c89-475d-a0db-d0141ae449f3

	measure 'Variacao Vendas %' = DIVIDE([Total Vendas] - [Vendas Ano Anterior], [Vendas Ano Anterior])
		formatString: 0.0%
		displayFolder: Medidas
		lineageTag: 629b973b-85d2-48f8-a3fc-5307d39a59f9

	measure 'Rank Produto' = RANKX(ALL(D_Produtos[Produto]), [Total Vendas], , DESC, Dense)
		formatString: 0
		displayFolder: Ranking
		lineageTag: 3bcce64b-ebb0-4147-8041-6e1ee8f198c1

	measure 'Vendas TOP3' = IF([Rank Produto] <= 3, [Total Vendas])
		formatString: $#,0
		displayFolder: Ranking
		lineageTag: a95a7ed1-c5fb-4bcb-810a-422c92738aba

	measure 'Participacao Vendas %' = DIVIDE([Total Vendas], CALCULATE([Total Vendas], ALLSELECTED()))
		formatString: 0.0%
		displayFolder: Ranking
		lineageTag: 23b77321-29ce-49fb-9c61-f5f62981ee33

