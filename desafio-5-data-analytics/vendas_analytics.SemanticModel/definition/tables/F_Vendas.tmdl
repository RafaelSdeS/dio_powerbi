	partition F_Vendas = m
		mode: import
		source =
				let
				    Origem = Financials_origem,
				    Taxa = Table.AddColumn(Origem, "Desconto %", each if [Gross Sales] = 0 then 0 else Number.Round([Discounts] / [Gross Sales], 4), type number),
				    SK = Table.AddIndexColumn(Taxa, "SK_ID", 1, 1, Int64.Type),
				    MProd = Table.NestedJoin(SK, {"Product"}, D_Produtos, {"Produto"}, "P", JoinKind.LeftOuter),
				    EProd = Table.ExpandTableColumn(MProd, "P", {"ID_Produto"}),
				    MDet = Table.NestedJoin(EProd, {"Product", "Sale Price", "Manufacturing Price"}, D_Produtos_Detalhes, {"Produto", "Sale Price", "Manufacturing Price"}, "PD", JoinKind.LeftOuter),
				    EDet = Table.ExpandTableColumn(MDet, "PD", {"ID_Produto_Detalhe"}),
				    MDesc = Table.NestedJoin(EDet, {"Discount Band", "Desconto %"}, D_Descontos, {"Discount Band", "Desconto %"}, "D", JoinKind.LeftOuter),
				    EDesc = Table.ExpandTableColumn(MDesc, "D", {"ID_Desconto"}),
				    MSeg = Table.NestedJoin(EDesc, {"Segment", "Country"}, D_Detalhes, {"Segment", "Country"}, "S", JoinKind.LeftOuter),
				    ESeg = Table.ExpandTableColumn(MSeg, "S", {"ID_Detalhe"}),
				    Selecionadas = Table.SelectColumns(ESeg, {"SK_ID", "ID_Produto", "ID_Produto_Detalhe", "ID_Desconto", "ID_Detalhe", "Date", "Units Sold", "Sale Price", "Gross Sales", "Discounts", "Sales", "COGS", "Profit"}),
				    Tipos = Table.TransformColumnTypes(Selecionadas, {{"ID_Produto", Int64.Type}, {"ID_Produto_Detalhe", Int64.Type}, {"ID_Desconto", Int64.Type}, {"ID_Detalhe", Int64.Type}})
				in
				    Tipos

	annotation PBI_ResultType = Table

