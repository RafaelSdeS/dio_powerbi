		sourceColumn: Total Unidades Vendidas

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition D_Produtos_Detalhes = m
		mode: import
		source =
				let
				    Origem = Financials_origem,
				    Agrupado = Table.Group(Origem, {"Product", "Sale Price", "Manufacturing Price"}, {{"Total Unidades Vendidas", each List.Sum([Units Sold]), type number}}),
				    Ordenado = Table.Sort(Agrupado, {{"Product", Order.Ascending}, {"Sale Price", Order.Ascending}}),
				    Indice = Table.AddIndexColumn(Ordenado, "ID_Produto_Detalhe", 1, 1, Int64.Type),
				    Mescla = Table.NestedJoin(Indice, {"Product"}, D_Produtos, {"Produto"}, "P", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mescla, "P", {"ID_Produto"}),
				    Renomeado = Table.RenameColumns(Expandido, {{"Product", "Produto"}}),
				    Colunas = Table.ReorderColumns(Renomeado, {"ID_Produto_Detalhe", "ID_Produto", "Produto", "Sale Price", "Manufacturing Price", "Total Unidades Vendidas"})
				in
				    Colunas

	annotation PBI_ResultType = Table

