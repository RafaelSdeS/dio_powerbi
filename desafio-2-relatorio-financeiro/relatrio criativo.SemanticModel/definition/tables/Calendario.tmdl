table Calendario
	lineageTag: 83ad5fde-8b54-44f4-91cc-c94793330ca4
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: d0bf5612-ec14-4ed7-b65c-e882053bf934
		summarizeBy: none
		sourceColumn: [Date]

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 2039b120-01b3-4133-a203-d9e382f231b8
		summarizeBy: none
		sourceColumn: [Ano]

	column 'Mes Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b9379ec8-139e-49dc-ab4c-b7c67426b4c8
		summarizeBy: none
		sourceColumn: [Mes Num]

	column Mes
		dataType: string
		lineageTag: 22ed4b2f-92da-4a6c-9766-3be1620a66a1
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: 'Mes Num'

	column Trimestre
		dataType: string
		lineageTag: 28136a2f-ffe8-4723-a58f-d8dcec8b1a81
		summarizeBy: none
		sourceColumn: [Trimestre]

	partition Calendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(MIN(financials[Year]), 1, 1),
				        DATE(MAX(financials[Year]), 12, 31)
				    ),
				    "Ano", YEAR([Date]),
				    "Mes Num", MONTH([Date]),
				    "Mes", FORMAT([Date], "mmm"),
				    "Trimestre", "T" & QUARTER([Date])
				)

	annotation PBI_ResultType = Table

