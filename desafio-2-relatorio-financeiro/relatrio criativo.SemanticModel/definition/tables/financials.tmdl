table financials
	lineageTag: e8984e47-1d48-449a-b98c-c9c571939304

	measure 'Total Vendas' = SUM(financials[ Sales])
		formatString: $#,0.0,,"M"
		displayFolder: Medidas Base
		lineageTag: 65cc2c41-b3d9-4bcf-9784-b6b002594361

	measure 'Total Lucro' = SUM(financials[Profit])
		formatString: $#,0.0,,"M"
		displayFolder: Medidas Base
		lineageTag: 9451280d-a2ec-498c-acff-ae326bb77ac0

	measure 'Unidades Vendidas' = SUM(financials[Units Sold])
		formatString: #,0.0,,"M"
		displayFolder: Medidas Base
		lineageTag: 65a75b3b-3920-4d44-ab47-ca81683269fd

	measure 'Total Descontos' = SUM(financials[Discounts])
		formatString: $#,0.0,,"M"
		displayFolder: Medidas Base
		lineageTag: a6fb5183-2b25-41a8-aca0-929dedd28804

	measure 'Total COGS' = SUM(financials[COGS])
		formatString: $#,0.0,,"M"
		displayFolder: Medidas Base
		lineageTag: ed7bd35f-712f-441a-897a-3289cb70d2f1

	measure 'Margem %' = DIVIDE([Total Lucro], [Total Vendas])
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: c6439fa7-643f-4350-90d4-59b42b5c4a56

	measure 'Ticket Medio' = DIVIDE([Total Vendas], [Unidades Vendidas])
		formatString: $#,0.00
		displayFolder: Indicadores
		lineageTag: e7e00df9-e36f-46a2-a475-2a61d7e227af

	measure 'Vendas Ano Anterior' = CALCULATE([Total Vendas], SAMEPERIODLASTYEAR(Calendario[Date]))
		formatString: $#,0.0,,"M"
		displayFolder: Inteligencia de Tempo
		lineageTag: c21efb57-f52a-444f-937e-3ca1af087379

	measure 'Variacao Vendas %' = DIVIDE([Total Vendas] - [Vendas Ano Anterior], [Vendas Ano Anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Inteligencia de Tempo
		lineageTag: 616ef2a2-4681-4127-8cb2-c7442f20cafb

	measure 'Metrica Selecionada' =
			SWITCH(
			    SELECTEDVALUE(Metrica[Metrica], "Vendas"),
			    "Vendas", [Total Vendas],
			    "Lucro", [Total Lucro],
			    "Unidades", [Unidades Vendidas],
			    "Descontos", [Total Descontos]
			)
		displayFolder: Seletor de Metrica
		lineageTag: c51fefcb-4f47-4aa2-a3b8-aaa29a50e967

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE(Metrica[Metrica], "Vendas"),
				    "Unidades", "#,0.0,,""M""",
				    "$#,0.0,,""M"""
				)

