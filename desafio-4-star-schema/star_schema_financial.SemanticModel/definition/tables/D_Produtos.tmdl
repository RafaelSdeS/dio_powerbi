	partition D_Produtos = m
		mode: import
		source =
				let
				    Origem = Financials_origem,
				    Agrupado = Table.Group(Origem, {"Product"}, {
				        {"Media Unidades Vendidas", each List.Average([Units Sold]), type number},
				        {"Media Valor Vendas", each List.Average([Sales]), type number},
				        {"Mediana Valor Vendas", each List.Median([Sales]), type number},
				        {"Valor Maximo Venda", each List.Max([Sales]), type number},
				        {"Valor Minimo Venda", each List.Min([Sales]), type number}
				    }),
				    Ordenado = Table.Sort(Agrupado, {{"Product", Order.Ascending}}),
				    Indice = Table.AddIndexColumn(Ordenado, "ID_Produto", 1, 1, Int64.Type),
				    Renomeado = Table.RenameColumns(Indice, {{"Product", "Produto"}}),
				    Classificacao = Table.AddColumn(Renomeado, "Indice de Produtos", each
				        if [Media Valor Vendas] >= 180000 then "Alto"
				        else if [Media Valor Vendas] >= 160000 then "Medio"
				        else "Baixo", type text),
				    Colunas = Table.ReorderColumns(Classificacao, {"ID_Produto", "Produto", "Indice de Produtos", "Media Unidades Vendidas", "Media Valor Vendas", "Mediana Valor Vendas", "Valor Maximo Venda", "Valor Minimo Venda"})
				in
				    Colunas

	annotation PBI_ResultType = Table

